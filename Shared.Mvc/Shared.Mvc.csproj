<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- Package Configuration -->
    <PackageId>DevMuhsener.Shared.Mvc</PackageId>
    <Version>1.0.0</Version>
    <Authors>devmuhsener</Authors>
    <Company>yetenek.ai</Company>
    <Description>A helpful library built on .NET 10</Description>
    <PackageTags>dotnet10;utility</PackageTags>
    <PackageOutputPath>$(HOME)/LocalNuGet</PackageOutputPath>

    <!-- Generate the .nupkg file every time you build -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

